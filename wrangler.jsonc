{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static assets only: no Worker script, no SSR adapter.
  // Deployed by Cloudflare Workers Builds (Git integration); no tokens live in this repo.
  "name": "koukenhou-site",
  "compatibility_date": "2026-11-11",
  "assets": {
    // Output of `npm run build`.
    "directory": "./dist",
    // Unmatched paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // The public site is https://koukenhou.com (custom domain set in the dashboard).
  // *.workers.dev stays on because branch and pull request previews are served from it.
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, the Workers Builds preview command. Empty on purpose:
  // previews inherit assets and compatibility settings from the top level.
  "previews": {}
}
