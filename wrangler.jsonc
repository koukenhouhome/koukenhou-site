{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static assets only: no Worker script, no SSR adapter.
  // Deployed by Cloudflare Workers Builds (Git integration); no tokens live in this repo.
  "name": "koukenhou-site",
  "compatibility_date": "2026-11-11",
  "assets": {
    // Output of `npm run build`.
    "directory": "./dist",
    // Unmatched paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
