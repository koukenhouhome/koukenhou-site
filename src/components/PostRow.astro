---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingMinutes } from '../lib/content';

interface Props {
  post: CollectionEntry<'life'>;
}

const { post } = Astro.props;
---

<li>
  <a class="row" href={`/life/${post.id}/`}>
    <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
    <span class="title">{post.data.title}</span>
    <span class="desc">{post.data.description}</span>
    <span class="minutes">约 {readingMinutes(post.body)} 分钟</span>
  </a>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.125rem 1rem;
    padding: 0.875rem 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .row:hover {
    background: var(--hover);
  }
  time {
    grid-row: 1 / span 3;
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    padding-top: 0.125rem;
  }
  .title {
    font-weight: 600;
    color: var(--accent);
  }
  .desc {
    color: var(--muted);
  }
  .minutes {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  /* Phone width: date above the title instead of a separate column. */
  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 1fr;
    }
    time {
      grid-row: auto;
      padding-top: 0;
    }
  }
</style>
