---
import { getCollection } from 'astro:content';
import WorkCard from '../components/WorkCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section>
    <h1>你好，我是 Koukenhou</h1>
    <!-- TODO(owner): replace with your own one-line introduction. -->
    <p>个人开发者。这里记录我做的软件和开发过程。</p>
  </section>

  <section>
    <h2>作品</h2>
    <div class="works">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .works {
    display: grid;
    gap: 1rem;
  }
</style>
